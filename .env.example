# Supabase projesi > Project Settings > API
# Yalnızca herkese açık (anon / publishable) anahtar kullanılır.
# service_role anahtarını bu dosyaya veya uygulamaya ASLA eklemeyin.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# İsteğe bağlı: paylaşım bağlantılarının web adresi (örn. https://look.app).
# Boş bırakılırsa uygulama bağlantısı (look://...) paylaşılır.
EXPO_PUBLIC_WEB_URL=
